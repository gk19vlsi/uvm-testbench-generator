{
    "name": "@uvm-chatbot/backend",
    "version": "1.0.0",
    "description": "Backend server for UVM Testbench Chatbot",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "start:prod": "cd /opt/render/project/src/backend && node dist/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:db": "ts-node src/scripts/test-db-connection.ts",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@langchain/openai": "^0.0.14",
        "@types/archiver": "^7.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/markdown-it": "^13.0.7",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.10",
        "@types/pdf-parse": "^1.1.4",
        "@types/uuid": "^9.0.7",
        "@uvm-chatbot/shared-types": "*",
        "archiver": "^7.0.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "langchain": "^0.1.10",
        "mammoth": "^1.6.0",
        "markdown-it": "^14.0.0",
        "mongodb": "^6.3.0",
        "multer": "^1.4.5-lts.1",
        "pdf-parse": "^1.1.1",
        "socket.io": "^4.6.1",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/socket.io-client": "^1.4.36",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "nodemon": "^3.0.3",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}