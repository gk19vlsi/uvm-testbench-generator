// APB Protocol-Specific Driver Logic
// Handles APB setup, access, and transfer phases

// Setup phase
@(vif.driver_cb);
vif.driver_cb.psel <= 1'b1;
vif.driver_cb.paddr <= trans.addr;
vif.driver_cb.pwrite <= (trans.trans_type == WRITE);
if (trans.trans_type == WRITE) begin
  vif.driver_cb.pwdata <= trans.data;
end
vif.driver_cb.penable <= 1'b0;

// Access phase
@(vif.driver_cb);
vif.driver_cb.penable <= 1'b1;

// Transfer phase - wait for pready
while (!vif.driver_cb.pready) begin
  @(vif.driver_cb);
end

// Capture read data if read transaction
if (trans.trans_type == READ) begin
  trans.data = vif.driver_cb.prdata;
end

// Capture response
if (vif.driver_cb.pslverr) begin
  trans.resp = ERROR;
end else begin
  trans.resp = OKAY;
end

// Return to idle
@(vif.driver_cb);
vif.driver_cb.psel <= 1'b0;
vif.driver_cb.penable <= 1'b0;
