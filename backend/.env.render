# Render Production Environment Variables
# Copy these to your Render backend service environment variables

NODE_ENV=production
PORT=4000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Database > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/uvm-chatbot

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# CORS Origin - Update this after deploying frontend
# Format: https://your-frontend-name.onrender.com
CORS_ORIGIN=https://uvm-testbench-frontend.onrender.com

# Logging
LOG_LEVEL=info

# File Storage
UPLOAD_DIR=./projects
