# Frontend Production Environment Variables
# These will be set in Render static site environment variables

# Backend API URL - Update this after deploying backend
# Format: https://your-backend-name.onrender.com
VITE_API_URL=https://uvm-testbench-backend.onrender.com

# WebSocket URL - Same as API URL
VITE_WS_URL=https://uvm-testbench-backend.onrender.com
