# Production Environment Variables
# Copy this file to .env.production and fill in your values

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGODB_URI=mongodb://admin:your_secure_password_here@mongodb:27017/uvm-chatbot?authSource=admin

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Configuration
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://yourdomain.com
LOG_LEVEL=info

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com

# File Storage
UPLOAD_DIR=/app/projects

# Security (Optional - for future enhancements)
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here

# Monitoring (Optional)
# SENTRY_DSN=your_sentry_dsn_here
# NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# Email Notifications (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# Rate Limiting (Optional - override defaults)
# RATE_LIMIT_UPLOAD=10
# RATE_LIMIT_GENERATION=5
# RATE_LIMIT_API=100
